        {
          "id": "F-pmc",
          "name": "PMC et PME",
          "formula": "PMC = ΔC/ΔY = c ; PME = ΔS/ΔY = 1-c ; PMC + PME = 1",
          "tags": ["Formule", "Keynes"],
          "relatedNotions": ["M1-I-2a", "M1-I-2b"],
