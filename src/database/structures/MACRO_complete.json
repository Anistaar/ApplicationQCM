            {"id": "M3-III-2", "number": "2", "name": "Équation de Cambridge", "notions": [{"id": "M3-III-2a", "name": "Équation Cambridge", "description": "M = k·P·Y où k=1/v. Fraction revenu nominal détenue en monnaie. Équivalent Fisher avec k constant", "tags": ["Monnaie"], "difficulty": "Moyen", "estimatedTime": 11, "relatedAuthors": ["A-marshall"], "relatedFormulas": ["F-cambridge"], "relatedNotions": ["M3-III-1a"]}], "estimatedTime": 11},
